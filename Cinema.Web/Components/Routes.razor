<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.ClientLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Layout.ClientLayout)">
            <div class="cinema-empty">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="mt-2 mb-4">Сторінку не знайдено</MudText>
                <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">На афішу</MudButton>
            </div>
        </LayoutView>
    </NotFound>
</Router>
