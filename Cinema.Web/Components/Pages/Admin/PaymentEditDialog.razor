@using Cinema.Domain.Common
@inject IPaymentService PaymentService

<MudDialog>
    <DialogContent>
        <MudNumericField T="decimal" @bind-Value="_amount" Label="Сума, грн" Variant="Variant.Outlined" />
        <MudSelect T="string" @bind-Value="_method" Label="Спосіб оплати" Variant="Variant.Outlined" Class="mt-3">
            @foreach (var m in PaymentMethod.All)
            {
                <MudSelectItem T="string" Value="@m">@m</MudSelectItem>
            }
        </MudSelect>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Скасувати</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Зберегти</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Payment Payment { get; set; } = null!;

    private decimal _amount;
    private string _method = null!;
    private string? _error;

    protected override void OnParametersSet()
    {
        _amount = Payment.Amount;
        _method = Payment.PaymentMethod;
    }

    private async Task SaveAsync()
    {
        var result = await PaymentService.UpdateAsync(Payment.PaymentId, _amount, _method);
        if (!result.Success)
        {
            _error = result.Error;
            return;
        }
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Close(DialogResult.Cancel());
}