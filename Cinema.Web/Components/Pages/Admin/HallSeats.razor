@page "/admin/halls/{HallId:int}/seats"
@page "/admin/seats"
@inject IHallService HallService
@inject ISeatService SeatService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Місця залу</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudSelect T="int" Value="_selectedHallId" ValueChanged="OnHallChanged"
               Label="Зал" Variant="Variant.Outlined">
        @foreach (var h in _halls)
        {
            <MudSelectItem T="int" Value="@h.HallId">@h.HallName</MudSelectItem>
        }
    </MudSelect>
</MudPaper>

@if (_hall is null)
{
    <MudAlert Severity="Severity.Warning">Зал не знайдено.</MudAlert>
    <MudButton Href="/admin/halls" Class="mt-2">До списку залів</MudButton>
    <MudAlert Severity="Severity.Info">Оберіть зал, щоб побачити схему місць.</MudAlert>
    return;
}

<MudText Typo="Typo.subtitle1" Class="mb-4">
    «@_hall.HallName»: @_seats.Count місць, @_hall.RowsCount рядів
</MudText>

<MudGrid>
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Схема залу (натисніть місце, щоб редагувати)</MudText>
            <MudPaper Outlined="true" Class="pa-1 mb-4" Style="text-align:center; margin-left:80px; margin-right:80px">Екран</MudPaper>

            @foreach (var row in _seats.GroupBy(s => s.RowNumber).OrderBy(g => g.Key))
            {
                <div style="position:relative; padding:0 80px; margin-bottom:6px; min-height:36px; display:flex; align-items:center; justify-content:center;">
                    <MudText Style="position:absolute; left:0; width:70px;">Ряд @row.Key</MudText>
                    <MudStack Row="true" Spacing="1" Justify="Justify.Center" Wrap="Wrap.Wrap">
                        @foreach (var seat in row.OrderBy(s => s.SeatNumber))
                        {
                            var selected = _editing.SeatId == seat.SeatId;
                            <MudTooltip Text="@($"{seat.Price:0.00} грн")">
                                <MudButton Size="Size.Small"
                                           Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                                           Color="Color.Default"
                                           Style="@SeatStyle(selected)"
                                           OnClick="() => Select(seat)">@seat.SeatNumber</MudButton>
                            </MudTooltip>
                        }
                    </MudStack>
                </div>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1" Class="mb-2">
                @(_editing.SeatId == 0 ? "Нове місце" : "Редагування місця")
            </MudText>
            <MudStack>
                <MudNumericField T="int" @bind-Value="_editing.RowNumber" Label="Ряд"
                                 Variant="Variant.Outlined" HelperText="@($"Від 1 до {_hall.RowsCount}")" />
                <MudNumericField T="int" @bind-Value="_editing.SeatNumber" Label="Номер місця"
                                 Variant="Variant.Outlined" />
                <MudNumericField T="decimal" @bind-Value="_editing.Price" Label="Ціна, грн"
                                 Variant="Variant.Outlined" HelperText="Від 0 до 10000" />
                <MudStack Row="true">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Зберегти</MudButton>
                    @if (_editing.SeatId != 0)
                    {
                        <MudButton Color="Color.Error" OnClick="DeleteAsync">Видалити</MudButton>
                        <MudButton Variant="Variant.Text" OnClick="ResetForm">Нове місце</MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Ціна для всього ряду</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudNumericField T="int" @bind-Value="_bulkRow" Label="Ряд" Variant="Variant.Outlined" />
                <MudNumericField T="decimal" @bind-Value="_bulkPrice" Label="Ціна, грн" Variant="Variant.Outlined" />
                <MudButton Variant="Variant.Filled" OnClick="ApplyRowPriceAsync">Застосувати</MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public int? HallId { get; set; }

    private Hall? _hall;
    private List<Hall> _halls = new();
    private List<Seat> _seats = new();
    private Seat _editing = new();
    private int _selectedHallId;
    private int _bulkRow = 1;
    private decimal _bulkPrice = 120;

    protected override async Task OnParametersSetAsync()
    {
        _halls = (await HallService.GetAllAsync()).OrderBy(h => h.HallName).ToList();

        _selectedHallId = HallId ?? _halls.FirstOrDefault()?.HallId ?? 0;
        if (_selectedHallId == 0) { _hall = null; return; }

        _hall = await HallService.GetByIdAsync(_selectedHallId);
        ResetForm();
        await LoadAsync();
    }

    private async Task OnHallChanged(int hallId)
    {
        _selectedHallId = hallId;
        _hall = await HallService.GetByIdAsync(hallId);
        ResetForm();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _hall = await HallService.GetByIdAsync(_selectedHallId);
        _seats = await SeatService.GetByHallAsync(_selectedHallId);
    }

    private static string SeatStyle(bool selected) => selected
        ? "min-width:36px; background-color:var(--mud-palette-text-primary); color:var(--mud-palette-surface); border-color:var(--mud-palette-text-primary);"
        : "min-width:36px; color:var(--mud-palette-text-primary); border-color:var(--mud-palette-text-primary);";

    private void ResetForm() => _editing = new Seat { HallId = _selectedHallId, RowNumber = 1, SeatNumber = 1, Price = 120 };

    private void Select(Seat s) => _editing = new Seat
    {
        SeatId = s.SeatId,
        HallId = s.HallId,
        RowNumber = s.RowNumber,
        SeatNumber = s.SeatNumber,
        Price = s.Price
    };

    private async Task SaveAsync()
    {
        var result = await SeatService.SaveAsync(_editing);
        if (!result.Success)
        {
            Snackbar.Add(result.Error!, Severity.Error);
            return;
        }
        Snackbar.Add("Збережено", Severity.Success);
        ResetForm();
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Підтвердження",
            $"Видалити місце: ряд {_editing.RowNumber}, місце {_editing.SeatNumber}?",
            yesText: "Видалити", cancelText: "Скасувати");
        if (confirm != true) return;

        var result = await SeatService.DeleteAsync(_editing);
        Snackbar.Add(result.Success ? "Видалено" : result.Error!,
                     result.Success ? Severity.Success : Severity.Error);
        if (result.Success)
        {
            ResetForm();
            await LoadAsync();
        }
    }

    private async Task ApplyRowPriceAsync()
    {
        var result = await SeatService.SetRowPriceAsync(_selectedHallId, _bulkRow, _bulkPrice);
        Snackbar.Add(result.Success ? "Ціни ряду оновлено" : result.Error!,
                     result.Success ? Severity.Success : Severity.Error);
        if (result.Success) await LoadAsync();
    }
}